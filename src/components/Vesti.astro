---
import Slider from "@components/Slider.astro";
import Card from "@components/Card.astro";
import { collection } from "@scripts/i18n.ts";


interface Props {
  text: string
}

const { text } = Astro.props;

const { lang } = Astro.params;

const vesti = await collection("vesti", lang);
---
<Slider>
  {
    vesti
      .slice(0, 3)
      .map((post) => <Card link={`/${lang}/vesti/${post.id}`} {...post} />)
  }
  <a slot="button" href=`/${lang}/vesti` class="button primary dugme">
    {text}
  </a>
</Slider>
