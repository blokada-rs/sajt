---
interface Props {
  link: string;
  text: string;
}

const { link, text } = Astro.props;
const { lang } = Astro.params;

let lang_link = link;
if (
  link.startsWith("/") &&
  Astro.params.lang != "sr" &&
  Astro.params.lang != "root"
) {
  lang_link = `/${lang}${link}`;
}
---

<div class="buttons">
  <a href={lang_link} class="button primary dugme center">
    {text}
  </a>
</div>
