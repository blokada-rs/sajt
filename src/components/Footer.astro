---
import { Icon } from "astro-icon/components";
import { ICON_SIZE_LG } from "consts";
import { file } from "@scripts/i18n.ts";

const { lang } = Astro.params;
const { frontmatter } = await file("ostalo", lang);

const socialIcons = [
  {
    label: "Instagram",
    icon: "simple-icons:instagram",
    link: "https://instagram.com/studenti_u_blokadi",
  },
  {
    label: "Twitter",
    icon: "simple-icons:twitter",
    link: "https://x.com/studentblokade",
  },
  {
    label: "Facebook",
    icon: "simple-icons:facebook",
    link: "https://www.facebook.com/people/Studenti-u-blokadi-UB/61571631694236/",
  },
  {
    label: "Git",
    icon: "simple-icons:git",
    link: "https://git.blokade.org/blokade-org/sajt",
  },
];
---

<footer>
  <div class="footer-container">
    <div>{frontmatter.studenti_u_blokadi}</div>
    <div class="social-links">
      {
        socialIcons.map(({ label, icon, link }) => (
          <a
            aria-label={label}
            href={link}
            target="_blank"
            rel="noopener noreferrer"
            style={`height: ${ICON_SIZE_LG}px;`}
          >
            <Icon name={icon} size={ICON_SIZE_LG} class="icon" />
          </a>
        ))
      }
    </div>
  </div>
</footer>

<style>
  .footer-container {
    width: 70rem;
    max-width: calc(100% - 2em);
    margin: auto;
    padding: 0em 1em;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .social-links {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1em;
  }
  .icon {
    color: rgb(var(--gray));
  }
  .icon:hover {
    color: rgb(var(--gray-dark));
    cursor: pointer;
  }
  @media (max-width: 720px) {
    .footer-container {
      flex-direction: column;
    }
    .social-links {
      margin-top: 1em;
    }
  }
</style>
