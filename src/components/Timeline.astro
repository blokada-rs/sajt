---
import { Markdown } from "@mashehu/astropub-md";
import { Picture } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import FormattedDate from "./FormattedDate.astro";

type Props = {
  timeline: CollectionEntry<"vesti">["data"]["timeline"];
  border?: "light" | "dark";
};
const { timeline, border = "light" } = Astro.props;
---

{typeof timeline !== "undefined" && (
  <div class="desavanja">
    {timeline.map((post) => (
      <article class:list={[post.color ?? "first", {"important": post.important}]}>
        <h3 class:list={[{ dark: border === "dark" }]}>{post.naslov}</h3>
        <FormattedDate date={post.datum} time />
        {(post.videos?.length ?? 0) > 0 && (
          <div class="videi">
            {post.videos?.map((video) => <iframe
                src={`https://www.youtube-nocookie.com/embed/${video}`}
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
              ></iframe>)}
          </div>
        )}
        {(post.slike?.length ?? 0) > 0  && (
          <div class="slike">
            {post.slike?.map((slika) => (
              <Picture formats={["avif", "webp"]} src={slika} alt="" />
            ))}
          </div>
        )}

        {typeof post.tekst !== "undefined" && <Markdown of={post.tekst} />}
      </article>
    ))}
  </div>
)}

<style>
  .desavanja {
    border-left: 4px solid var(--on-background);
    padding-left: 1rem;
  }

  .desavanja:not(:first-child) {
    margin-top: 2rem;
  }

  article {
    position: relative;
  }

  .important {
    color: var(--on-primary);
    padding: 1.5rem;
  }

  .important h3::before {
    left: calc(-15px - 2.5rem);
  }

  .important::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: var(--color);
    border-radius: 8px;
  }

  article:not(:last-of-type) {
    padding-block: 1rem;
    margin-bottom: 1rem;
  }

  article h3 {
    position: relative;
    margin-bottom: 0;
  }

  article h3::before {
    content: "";
    display: block;
    position: absolute;
    width: 14px;
    height: 14px;
    background-color: var(--color);
    top: 50%;
    translate: 0 -50%;
    left: calc(-15px - 1rem);
    border-radius: 50%;
    border: 6px solid var(--background);
  }

  article h3.dark::before {
    border-color: hsl(0, 0%, 95%);
  }

  article p {
    margin-top: 0.5rem;
    margin-bottom: 0;
    text-align: justify;
  }

  article :global(blockquote) {
    margin-top: 1rem;
  }

  .slike, .videi {
    margin-block: 1rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
    gap: 1rem;
  }

  @media (max-width: 700px) {
    .slike, .videi {
      grid-template-columns: 1fr;
    }
  }

  .slike img {
    width: 100%;
  }

  iframe {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: none;
    border-radius: 8px;
  }
</style>
