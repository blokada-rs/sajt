---
import { Picture } from "astro:assets";
interface Props {
  image: ImageMetadata
  text: string
}

const { image, text } = Astro.props;
---

<>
  <div class="title">
    <Picture
      formats={["avif", "webp"]}
      width={1020}
      src={image}
      loading="eager"
      alt=""
    />
    <h1>{text}</h1>

    <div class="square" />
    <div class="square" />
  </div>
</>
