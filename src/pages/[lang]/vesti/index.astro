---
import { Image } from 'astro:assets';

import { collection, langs } from "@scripts/translate";

import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../../consts';
import RecentNewsMasonry from '../../../components/RecentNewsMasonry.astro';


const { lang } = Astro.params;

export async function getStaticPaths() {
	return langs.map(lang => ({params: {lang}}))
}
const allPosts = await collection('vesti', lang);
const recentPosts = allPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<!doctype html>
<html lang=lang>
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<div class="" style="">
			<RecentNewsMasonry recentPosts={recentPosts}/>
		</div>
		<Footer />
	</body>
</html>
