---
import Base from "@layouts/Base.astro";
import { collection, collectionIDs, entry, file, langs } from "@scripts/i18n";
import { Icon } from "astro-icon/components";
import { type CollectionEntry } from "astro:content";
import { SITE_DESCRIPTION } from "../../../consts";
import { ICON_SIZE_LG } from "consts";
import { icons, socials } from "@scripts/collections";

const { lang } = Astro.params;
if (typeof lang === "undefined") {
  return Astro.rewrite(`/sr${Astro.url.pathname}`);
}

export async function getStaticPaths() {
  const linkovi = await collectionIDs("linkovi");

  return Promise.all(
    langs
      .flatMap((lang) => linkovi.flatMap((id) => ({ lang, id })))
      .map(async ({ lang, id }) => ({
        params: { lang, slug: id },
        props: await entry("linkovi", id, lang),
      })),
  );
}

type Props = CollectionEntry<"linkovi"> & { lang: string };

const linkovi = Astro.props;

const get_socials = (links) =>
  links.filter(({ type }) => socials.some(({ value }) => type === value));

const get_others = (links) =>
  links.filter(({ type }) => !socials.some(({ value }) => type === value));

const vesti = await collection("vesti", lang);

const { frontmatter: ostali_linkovi } = await file("ostali_linkovi", lang);

const { data: sub } = await entry("linkovi", "studenti_u_blokadi", lang);

const live = vesti.filter((vest) => vest.data.live);
---

<Base class:list={[{"suss": linkovi.id === "suss"}]} title=`Linkovi | ${linkovi.data.title}` description={SITE_DESCRIPTION}>
  {
    live.length > 0 && (
      <>
        <h1>Vesti uživo</h1>
        <ul>
          {live.map((live) => (
            <li>
              <a class="live button" href={`/${lang}/vesti/${live.data.link}`}>
                <Icon size={ICON_SIZE_LG} name="mdi:newspaper" />
                {live.data.title}
              </a>
            </li>
          ))}
        </ul>
      </>
    )
  }
  <h1>{linkovi.data.title}</h1>
  {
    get_others(linkovi.data.linkovi).length > 0 && (
      <ul>
        {get_others(linkovi.data.linkovi).map((link) => (
          <li class="spread">
            <a class="button" href={link.link}>
              {link.type !== "bez" && (
                <Icon
                  size={ICON_SIZE_LG}
                  name={icons.find((e) => e.value === link.type)?.icon!}
                />
              )}
              {link.naslov}
            </a>
          </li>
        ))}
      </ul>
    )
  }
  {
    get_socials(linkovi.data.linkovi).length > 0 && (
      <ul class="socials">
        {get_socials(linkovi.data.linkovi).map((link) => (
          <li>
            <a class="button" href={link.link}>
              {link.type !== "bez" && (
                <Icon
                  size={ICON_SIZE_LG}
                  name={icons.find((e) => e.value === link.type)?.icon!}
                />
              )}
            </a>
          </li>
        ))}
      </ul>
    )
  }
  <h1>{ostali_linkovi.ostali_linkovi}</h1>
  <ul>
    {
      ostali_linkovi.linkovi.map((link) => (
        <li>
          <a class="button" href={link.link}>
            {link.type !== "bez" && (
              <Icon
                size={ICON_SIZE_LG}
                name={icons.find((e) => e.value === link.type)?.icon!}
              />
            )}
            {link.naslov}
          </a>
        </li>
      ))
    }
  </ul>

  <h1>{ostali_linkovi.najnovije_vesti}</h1>
  <ul>
    {
      vesti.slice(0, 3).map((vest) => (
        <li>
          <a class="button" href={`/${lang}/vesti/${vest.data.link}`}>
            <Icon size={ICON_SIZE_LG} name="mdi:newspaper" />
            {vest.data.title}
          </a>
        </li>
      ))
    }
  </ul>
  {
    linkovi.data.title !== sub.title && (
      <>
        <h1>{sub.title}</h1>
        <ul class="socials">
          {get_socials(sub.linkovi).map((link) => (
            <li>
              <a class="button" href={link.link}>
                {link.type !== "bez" && (
                  <Icon
                    size={ICON_SIZE_LG}
                    name={icons.find((e) => e.value === link.type)?.icon!}
                  />
                )}
              </a>
            </li>
          ))}
        </ul>
      </>
    )
  }
</Base>

<style>
  h1 {
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-size: 1.75rem;
  }

  ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 0;
  }

  .socials {
    flex-direction: row;
    flex-wrap: wrap;
  }

  .socials li {
    flex-grow: 1;
  }

  .socials a {
    justify-content: center;
  }

  a {
    display: flex;

    align-items: center;
    gap: 1rem;

    padding: 1rem;

    background-color: var(--background);
  }

  a.live {
    border-color: var(--live);
  }

  a:hover {
    filter: opacity(0.5);
  }
</style>
