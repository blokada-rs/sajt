---
import Base from "@layouts/Base.astro";
import { collection, file, langs } from "@scripts/i18n";
import { Picture } from "astro:assets";
import { Markdown } from "@mashehu/astropub-md";

import { SITE_DESCRIPTION } from "../../consts";
import slavija from "@assets/images/slavija-test.jpg";
import Live from "@components/Live.astro";
import Slider from "../../components/Slider.astro";
import Card from "../../components/Card.astro";

export async function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
if (typeof lang === "undefined") {
  return Astro.rewrite(`/sr${Astro.url.pathname}`);
}

const { frontmatter: pocetna } = await file("pocetna", lang);
const { Content: Zahtevi } = await file("zahtevi", lang);

const vesti = await collection("vesti", lang);
const live = vesti.filter((vest) => vest.data.live);
---

<Base title={pocetna.naslov} description={SITE_DESCRIPTION} image={slavija.src}>
  <div class="title">
    <Picture
      fetchpriority="high"
      formats={["avif", "webp"]}
      src={slavija}
      loading="eager"
      alt=""
      widths={[240, 540, 720, slavija.width]}
      width={slavija.width}
      height={320}
      sizes={`(max-width: 360px) 240px, (max-width: 720px) 540px, (max-width: 1600px) 720px, ${slavija.width}px`}
    />
    <h1>{pocetna.naslov}</h1>

    <div class="square"></div>
    <div class="square"></div>
  </div>

  <div class="live-box">
    {
      live.map((live) => (
        <Live href={`/${lang}/vesti/${live.id}`}>{live.data.title}</Live>
      ))
    }
  </div>

  {
    pocetna.sections.map((section, i) => (
      <section class:list={[{'dark-background': i % 2 === 1}]}>
        {section.title && <h2>{section.title}</h2>}
        {section.text && <Markdown of={section.text} />}
        {section.special === "vesti" &&
          <Slider>
            {
              vesti
                .slice(0, 3)
                .map((post) => <Card link={`/${lang}/vesti/${post.id}`} {...post} />)
            }
            <a slot="button" href=`/${lang}/vesti` class="button primary dugme"
              >{section.link_text}</a
            >
          </Slider>
        }
        {section.special === "zahtevi" && <Zahtevi />}
        {section.special !== "vesti" && section.link && (
          <div class="buttons">
            <a
              slot="button"
              href={section.link}
              class="button primary dugme center"
            >
              {section.link_text}
            </a>
          </div>
        )}
      </section>
    ))
  }
</Base>

<style>
  .title {
    position: relative;
    background-size: cover;
    background-position: center;
    height: 22rem;
    max-height: 30vh;

    display: flex;
    align-items: center;

    margin-inline: 1rem;
    margin-block: 3rem;
  }

  .title :is(picture, img) {
    position: absolute;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .title::before {
    content: "";
    position: absolute;
    background-color: rgba(0, 0, 0, 0.4);
    inset: 0;
    z-index: 1;
    border-radius: 0.5rem;
  }

  .title h1 {
    margin-inline: auto;
    margin-block: 0;
    padding-inline: 2rem;
    color: white;
    z-index: 1;
    font-size: 4rem;
    text-align: center;
  }

  .title .square {
    width: 8rem;
    aspect-ratio: 2;
    z-index: 2;
    position: absolute;
    border-radius: 0.5rem;

    background: hsla(from var(--accent) h s l / 0.8);
    backdrop-filter: blur(6px);
  }

  .title .square:nth-of-type(1) {
    bottom: -1rem;
    left: -1rem;
  }

  .title .square:nth-of-type(2) {
    top: -1rem;
    right: -1rem;
  }

  section :global(ol) {
    padding-inline-start: 4rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  section :global(ol) :global(::marker) {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1;
  }

  @media (max-width: 720px) {
    .title h1 {
      padding-inline: 2vw;
      font-size: 10vw;
    }
  }

  .live-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    z-index: 3;
    margin-top: -1rem;
    margin-bottom: 1rem;
  }

  .dugme {
    padding: 1rem 2rem;
    border-radius: 0.5rem;
    width: fit-content;
  }

  .buttons {
    margin-top: 2rem;
    display: flex;
    justify-content: center;
  }
</style>
