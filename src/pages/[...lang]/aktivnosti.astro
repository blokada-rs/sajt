---
import Timeline from "@components/Timeline.astro";
import Base from "@layouts/Base.astro";

import { file, langs } from "@scripts/i18n";
const { lang } = Astro.params;

const { frontmatter } = await file("ostalo", lang);
const { frontmatter: aktivnosti } = await file("aktivnosti", lang);

export async function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
---

<Base
  title={`${aktivnosti.aktivnosti} | ${frontmatter.studenti_u_blokadi}`}
  description={frontmatter.afere_description}
>
  <div class="flex">
    <h1>{aktivnosti.aktivnosti}</h1>
  </div>
  <section>
    <Timeline timeline={aktivnosti.timeline} />
  </section>
</Base>
