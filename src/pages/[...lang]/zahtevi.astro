---
import Base from "@layouts/Base.astro";
import { Markdown } from "@mashehu/astropub-md";

import { SITE_DESCRIPTION } from "../../consts";

import { file, langs } from "@scripts/i18n";
export async function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
if (typeof lang === "undefined") {
  return Astro.rewrite(`/sr${Astro.url.pathname}`);
}

const { frontmatter } = await file("zahtevi", lang);
---

<Base title={frontmatter.title} description={SITE_DESCRIPTION}>
  <section>
    <h1>{frontmatter.naslov}</h1>

    <Markdown of={frontmatter.opis} />

    <div class="details-list">
      {
        frontmatter.zahtevi.map(
          (
            zahtev: { original: string; konkretizacija: string },
            idx: number,
          ) => (
            <details>
              <summary>
                <strong>{idx + 1}.</strong> {zahtev.original}
              </summary>
              <div class="content">
                <Markdown of={zahtev.konkretizacija} />
              </div>
            </details>
          ),
        )
      }
    </div>
  </section>
</Base>
