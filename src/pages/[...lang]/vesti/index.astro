---
import Base from "@layouts/Base.astro";
import { langs, collection, file } from "@scripts/i18n";

import { Picture } from "astro:assets";

import { SITE_TITLE, SITE_DESCRIPTION } from "../../../consts";
import FormattedDate from "../../../components/FormattedDate.astro";
import Live from "@components/Live.astro";
import { Markdown } from "@mashehu/astropub-md";

const { lang } = Astro.params;
if (typeof lang === "undefined") {
  return Astro.rewrite(`/sr${Astro.url.pathname}`);
}

const posts = await collection("vesti", lang);
const { frontmatter } = await file("ostalo", lang);

export async function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
---

<Base
  title={`${frontmatter.vesti} | ${frontmatter.studenti_u_blokadi}`}
  description={SITE_DESCRIPTION}
>
  <section>
    <h1>{frontmatter.vesti}</h1>
    <Markdown of={frontmatter.vesti_opis} />
  </section>
  <section>
    <ul>
      <li>
        <h2>{frontmatter.najnovija_vest}</h2>
        <a class="clear" href={`/${lang}/vesti/${posts[0].id}/`}>
          <Picture
            formats={["avif", "webp"]}
            width={720}
            src={posts[0].data.heroImage}
            loading="eager"
            alt=""
          />
          <div class="details">
            {posts[0].data.live && <Live>{frontmatter.live}</Live>}
            {
              lang !== posts[0].lang && (
                <p class="untranslated">Currently untranslated</p>
              )
            }
            <h2 class="title">{posts[0].data.title}</h2>
            <p class="date">
              <FormattedDate date={posts[0].data.pubDate} />
            </p>
            <p class="description">
              {posts[0].data.description}
            </p>
          </div>
        </a>
      </li>
      {
        posts.slice(1).map((post, index) => (
          <li>
            <a class="clear" href={`/${lang}/vesti/${post.id}/`}>
              <Picture
                formats={["avif", "webp"]}
                width={720}
                src={post.data.heroImage}
                loading={index <= 3 ? "eager" : "lazy"}
                alt=""
              />
              <div class="details">
                {post.data.live && <Live>{frontmatter.live}</Live>}
                {lang !== post.lang && (
                  <p class="untranslated">Currently untranslated</p>
                )}
                <h2 class="title">{post.data.title}</h2>
                <p class="date">
                  <FormattedDate date={post.data.pubDate} />
                </p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .flex {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  ul {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    flex-wrap: wrap;
    gap: 2rem;
    list-style-type: none;
    padding: 0;
  }

  li * {
    transition: 0.2s ease;
  }

  li h2 {
    font-size: 1.5rem;
  }

  li:first-child {
    padding-block: 2rem;
  }

  li:first-child,
  li:first-child a {
    position: relative;
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
  }

  li:first-child::before {
    content: "";
    position: absolute;
    background-color: var(--dark-background);
    inset: 0;
    left: 50%;
    translate: -50% 0;
    width: 100vw;
    height: 100%;
    z-index: -1;
  }

  li:first-child .details {
    grid-column: 2;
  }

  li > h2 {
    margin-bottom: 1rem;
  }

  .description {
    margin-top: 1rem;
  }

  li:not(:first-child) .details {
    margin-top: 1rem;
  }

  img {
    margin-bottom: 0.5rem;
    border-radius: 12px;
  }

  li > a {
    display: block;
    position: relative;
  }

  .title {
    margin: 0;
    color: rgb(var(--black));
    line-height: 1;
  }

  .date {
    margin: 0;
    color: rgb(var(--gray));
  }

  li > a:hover .title,
  li > a:hover .date {
    color: var(--accent);
  }

  li > a:hover img {
    box-shadow: var(--box-shadow);
  }

  @media (max-width: 720px) {
    ul {
      gap: 2em;
      grid-template-columns: 1fr;
    }

    li .details {
      margin-top: 1rem;
    }
  }

  section {
    padding-top: 0;
  }

  .live {
    position: absolute;
    top: 2rem;
    left: 2rem;
  }

  .untranslated {
    background-color: bisque;
  }
</style>
