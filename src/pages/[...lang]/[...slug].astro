---
import { collection, collectionIDs, entry, file, langs } from "@scripts/i18n";
import Base from "@layouts/Base.astro";
import { SITE_DESCRIPTION } from "../../consts";

import { Picture } from "astro:assets";
import { markdown, Markdown } from "@mashehu/astropub-md";
import Timeline from "@components/Timeline.astro";

import { type CollectionEntry, render } from "astro:content";
import Card from "@components/Card.astro";
import Slider from "@components/Slider.astro";
import Live from "@components/Live.astro";
import Mapa from "@components/Mapa.astro";

const { lang } = Astro.params;
if (typeof lang === "undefined") {
  return Astro.rewrite(`/sr${Astro.url.pathname}`);
}

export async function getStaticPaths() {
  const posts: (string | undefined)[] = await collectionIDs("specijalne_stranice");

  const pocetna = posts.indexOf("pocetna");
  if (pocetna != -1) {
    posts[pocetna] = undefined
  }

  return Promise.all(
    langs
      .flatMap((lang) => posts.flatMap((id) => ({ lang, id })))
      .map(async ({ lang, id }) => ({
        params: { lang, slug: id },
        props: await entry("specijalne_stranice", id, lang),
      })),
  );
}

type Props = CollectionEntry<"specijalne_stranice">;
await render(Astro.props);

const frontmatter = Astro.props.data;

const vesti_map = new Map();

await Promise.all(
  frontmatter.sections.map(async (s) => {
    if (s.special === "vest") {
      vesti_map.set(s.vest_id, await entry("vesti", s.vest_id, lang));
    }
  }),
);

const vesti = await collection("vesti", lang);
const live = vesti.filter((vest) => vest.data.live);

const { Content: Zahtevi } = await file("zahtevi", lang);

const map_data = await Promise.all(frontmatter.sections.map(async (section) => (
  section.map
    ? {
      ...section.map,
      markers: await Promise.all(
        section.map?.markers?.map(async (e) => ({
          ...e,
          text: await markdown(e.text),
        })) ?? [],
      ),
    }
    : null
)))

---

<Base class={frontmatter.class} title={frontmatter.title} description={SITE_DESCRIPTION}>
  {
    frontmatter.heroImage ? (
      <>
        <div class="title">
          <Picture
            formats={["avif", "webp"]}
            width={1020}
            src={frontmatter.heroImage}
            loading="eager"
            alt=""
          />
          <h1>{frontmatter.title}</h1>

          <div class="square" />
          <div class="square" />
        </div>
      </>
    ) : (
      <h1>{frontmatter.title}</h1>
    )
  }

  {frontmatter.link == "index" && (
    <div class="live-box">
      {
        live.map((live) => (
          <Live href={`/${lang}/vesti/${live.id}`}>{live.data.title}</Live>
        ))
      }
    </div>
  )}

  {
    frontmatter.sections.map((section: any, i: number) => (
      <section id={section.id} class:list={[{'dark-background': i % 2 === 1}]}>
        {section.title && <h2>{section.title}</h2>}
        {section.text && <Markdown of={section.text} />}
        {section.special === "vesti" &&
          <Slider>
            {
              vesti
                .slice(0, 3)
                .map((post) => <Card link={`/${lang}/vesti/${post.id}`} {...post} />)
            }
            <a slot="button" href=`/${lang}/vesti` class="button primary dugme"
            >{section.link_text}</a
            >
          </Slider>
        }
        {section.special === "zahtevi" && <Zahtevi />}
        {section.special !== "vesti" && section.link && (
          <div class="buttons">
            <a
              slot="button"
              href={section.link}
              class="button primary dugme center"
            >
              {section.link_text}
            </a>
          </div>
        )}
        {section.special === "vest" &&
          vesti_map.get(section.vest_id).data.timeline && (
            <>
              <Timeline
                timeline={vesti_map.get(section.vest_id).data.timeline}
                border={i % 2 === 0 ? "dark" : "light"}
              />
            </>
        )}
        {map_data[i] && <Mapa data={map_data[i]} /> }
      </section>
    ))
  }
</Base>

<style>
  .title {
    position: relative;
    background-size: cover;
    background-position: center;
    height: 22rem;
    max-height: 30vh;

    display: flex;
    align-items: center;

    margin-inline: 1rem;
    margin-block: 3rem;
  }

  .title :is(picture, img) {
    position: absolute;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .title::before {
    content: "";
    position: absolute;
    background-color: rgba(0, 0, 0, 0.4);
    inset: 0;
    z-index: 1;
    border-radius: 0.5rem;
  }

  .title h1 {
    margin-inline: auto;
    margin-block: 0;
    padding-inline: 2rem;
    color: white;
    z-index: 1;
    font-size: 4rem;
    text-align: center;
  }

  .title .square {
    width: 8rem;
    aspect-ratio: 2;
    z-index: 2;
    position: absolute;
    border-radius: 0.5rem;

    background: hsla(from var(--primary) h s l / 0.8);
    backdrop-filter: blur(6px);
  }

  .title .square:nth-of-type(1) {
    bottom: -1rem;
    left: -1rem;
  }

  .title .square:nth-of-type(2) {
    top: -1rem;
    right: -1rem;
  }

  section :global(ol) {
    padding-inline-start: 4rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  section :global(ol) :global(::marker) {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1;
  }

  @media (max-width: 720px) {
    .title h1 {
      padding-inline: 2vw;
      font-size: 10vw;
    }
  }

  .live-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    z-index: 3;
    margin-top: -1rem;
    margin-bottom: 1rem;
  }
</style>
