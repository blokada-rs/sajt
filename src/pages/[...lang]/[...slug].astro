---
import Base from "@layouts/Base.astro";
import { collection, collectionIDs, entry, langs } from "@scripts/i18n";
import { type CollectionEntry, render } from "astro:content";

import { Icon } from "astro-icon/components";
import { Picture } from "astro:assets";

import Live from "@components/Live.astro";
import Mapa from "@components/Mapa.astro";
import Notifications from "@components/Notifications.astro";
import SectionLink from "@components/SectionLink.astro";
import Vesti from "@components/Vesti.astro";
import Video from "@components/Video.astro";

import slsp from "@assets/images/slsp.svg";

export async function getStaticPaths() {
  const posts: (string | undefined)[] = await collectionIDs(
    "specijalne_stranice",
  );

  const pocetna = posts.indexOf("pocetna");
  if (pocetna != -1) {
    posts[pocetna] = undefined;
  }

  return Promise.all(
    langs
      .flatMap((lang) => posts.flatMap((id) => ({ lang, id })))
      .map(async ({ lang, id }) => ({
        params: { lang, slug: id },
        props: await entry("specijalne_stranice", id, lang),
      })),
  );
}

const { lang } = Astro.params;

type Props = CollectionEntry<"specijalne_stranice">;
const { Content, headings } = await render(Astro.props);

const frontmatter = Astro.props.data;

const vesti = await collection("vesti", lang);
const live = vesti.filter((vest) => vest.data.live && !vest.data.archived);
---

<Base
  class={frontmatter.class}
  title={frontmatter.title}
  description={frontmatter.description}
>
  {frontmatter.heroImage ? (
    <>
      <div class="title">
        <Picture
          class="cover"
          formats={["avif", "webp"]}
          width={1020}
          src={frontmatter.heroImage}
          loading="eager"
          alt=""
        />

        {frontmatter.link == "index" ? (
          <Picture
            class="slsp"
            formats={["svg"]}
            src={slsp}
            alt={frontmatter.title}
          />
        ) : (
          <h1>{frontmatter.title}</h1>
        )}

        <div class="square" />
        <div class="square" />
      </div>
    </>
  ) : (
    <h1>{frontmatter.title}</h1>
  )}

  {frontmatter.link == "index" && live.length > 0 && (
    <div class="live-box">
      {live.map((live) => (
        <Live
          href={`${lang === "sr" || lang === "root" ? "" : `/${lang}`}/vesti/${live.id}`}
        >
          {live.data.title}
        </Live>
      ))}
    </div>
  )}

  <Content
    components={{ Icon, SectionLink, Vesti, Mapa, Video, Notifications }}
  />
</Base>

<style>
  .title {
    position: relative;
    background-size: cover;
    background-position: center;
    height: 22rem;
    max-height: 30vh;

    display: flex;
    align-items: center;

    margin-inline: 1rem;
    margin-block: 3rem;
  }

  .title .cover {
    position: absolute;
    width: 100%;
    height: 100%;
    inset: 0;
    z-index: -1;
    object-fit: cover;
  }

  .title .slsp {
    position: absolute;
    width: 80%;
    height: 40%;
    inset: 0;
    margin: auto;
    z-index: 2;
    object-fit: contain;
  }

  .title::before {
    content: "";
    position: absolute;
    background-color: rgba(0, 0, 0, 0.4);
    inset: 0;
    z-index: 1;
    border-radius: 0.5rem;
  }

  .title h1 {
    margin-inline: auto;
    margin-block: 0;
    padding-inline: 2rem;
    color: white;
    z-index: 1;
    font-size: 4rem;
    text-align: center;
  }

  .title .square {
    width: 8rem;
    aspect-ratio: 2;
    z-index: 2;
    position: absolute;
    border-radius: 0.5rem;

    background: hsla(from var(--primary) h s l / 0.8);
    backdrop-filter: blur(6px);
  }

  .title .square:nth-of-type(1) {
    bottom: -1rem;
    left: -1rem;
  }

  .title .square:nth-of-type(2) {
    top: -1rem;
    right: -1rem;
  }

  :global(#zahtevi) > :global(ol) {
    padding-inline-start: 4rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  :global(#zahtevi) > :global(ol) :global(::marker) {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1;
  }

  @media (max-width: 720px) {
    .title h1 {
      padding-inline: 2vw;
      font-size: 10vw;
    }
  }

  .live-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    z-index: 3;
    margin-top: -1rem;
    margin-bottom: 1rem;
  }
</style>
