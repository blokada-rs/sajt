---
import Base from "./Base.astro";
import type { CollectionEntry } from "astro:content";
import { Picture } from "astro:assets";
import FormattedDate from "../components/FormattedDate.astro";
import Live from "@components/Live.astro";
import Timeline from "@components/Timeline.astro";
import { file } from "@scripts/i18n";

import 'leaflet/dist/leaflet.css';
import {ICON_SIZE_LG} from "../consts";
import {Icon} from "astro-icon/components";
import {markdown} from "@mashehu/astropub-md";

type Props = CollectionEntry<"vesti">["data"] & {lang: string, live?: boolean};

const { lang, title, description = "", pubDate, updatedDate, heroImage, live = false, live_embed, timeline, map: map_prerender = null } = Astro.props;
const map =
  (map_prerender !== null)
  ? {...map_prerender, markers: await Promise.all(map_prerender?.markers?.map(async (e) => ({...e, text: await markdown(e.text)})) ?? [])}
  : null

const { lang: expectedLang } = Astro.params;

const { frontmatter } = await file("ostalo", lang);
---

<Base title={`${title} | ${frontmatter.studenti_u_blokadi}`} description={description} image={heroImage.src}>
  {expectedLang !== lang &&
    <div class="full-width">
      This page is currently not translated to English. Showing the untranslated version.
    </div>
  }
  <article>
    <div class="hero-image">
      {
        heroImage && (
          <Picture transition:name={Astro.originPathname} formats={['avif', 'webp']} width={1020} src={heroImage} loading="eager" alt="" />
        )
      }
    </div>
    <div class="prose">
      <div class="title">
        <div class="about">
          {live && <Live>{frontmatter.live}</Live>}
          {pubDate && <FormattedDate date={pubDate} />}
        </div>
        <h1>{title}</h1>
        <hr />
      </div>

      {live_embed &&
        <div>
          <strong>{frontmatter.pratite_live}</strong>
          <br />
          <iframe
            class="live-embed"
            src={`https://www.youtube-nocookie.com/embed/${live_embed}`} 
            referrerpolicy="strict-origin-when-cross-origin" allowfullscreen 
          />
        </div>
      }

      { map &&
        <div class="center">
          <div data-map={JSON.stringify(map)} id="map">
            <div class="buttons">
              <button id="locate">
                <Icon name="mdi:my-location" size={ICON_SIZE_LG} />
              </button>
              <button id="fullscreen">
                <Icon name="mdi:fullscreen" size={ICON_SIZE_LG} />
              </button>
            </div>
          </div>
        </div>
      }

      <Timeline {timeline} />
      <article>
        <slot />
      </article>
    </div>
  </article>
</Base>

<style>
  .hero-image {
    margin-top: 2rem;
    width: 100%;
  }

  .hero-image img {
    display: block;
    margin: 0 auto;
    border-radius: 12px;
    box-shadow: var(--box-shadow);
  }
  .prose {
    color: rgb(var(--gray-dark));
  }

  .prose > :global(h1, h2, h3) {
    margin-top: 3rem;
    margin-bottom: 1rem;
  }

  .prose > :global(p) > :global(img) {
    width: 720px;
    max-width: calc(100% - 2em);
    display: block;
    margin-inline: auto;
  }

  article {
    margin-top: 1rem;
  }

  .title {
    padding-top: 1rem;
    text-align: center;
    line-height: 1;
  }

  .title h1 {
    margin: 0 0 0.5em 0;
  }

  .about {
    margin-bottom: 0.5em;
    color: rgb(var(--gray));
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }

  .last-updated-on {
    font-style: italic;
  }

  .full-width {
    text-align: center;
    background-color: bisque;
    position: sticky;
    top: calc(4rem - 2px);
    padding-block: 0.5rem;
    z-index: 50;
  }

  @media (max-width: 500px) {
    .title h1 {
      font-size: 8vw;
    }
  }

  .live-embed {
    max-width: 600px;
    width: 100%;
    border: none;
    border-radius: 8px;
    aspect-ratio: 16/9;
  }

  .center {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #map:not(.fullscreen) {
    max-width: 1000px;
    width: 100%;
    border: none;
    border-radius: 8px;
    aspect-ratio: 16/9;
    margin-top: 1rem;
    isolation: isolate;
  }

  #map :global(img) {
    border-radius: 0;
  }

  #map .buttons {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    z-index: 500;
    display: flex;
    flex-direction: column;
    gap: .5rem;
  }

  #map button {
    background-color: white;
  }

  #map button :global(svg) {
    display: block;
  }

  .fullscreen {
    position: fixed!important;
    z-index: 1000;
    inset: 0;
  }
</style>

<script>
  import leaflet from "leaflet";

  import MarkerIcon from "@assets/icons/marker.svg"
  import MarkerIconShadow from "@assets/icons/marker-shadow.svg"

  import MarkerLocationIcon from "@assets/icons/marker_location.svg"
  import MarkerLocationIconShadow from "@assets/icons/marker_location-shadow.svg"

  const marker_icon = leaflet.icon({
    iconSize: [48, 48],
    iconAnchor: [24, 44],
    popupAnchor: [0, -40],
    iconUrl: MarkerIcon.src,
    shadowUrl: MarkerIconShadow.src,
  });

  const marker_location_icon = leaflet.icon({
    iconSize: [48, 48],
    iconAnchor: [24, 44],
    popupAnchor: [0, -40],
    iconUrl: MarkerLocationIcon.src,
    shadowUrl: MarkerLocationIconShadow.src,
  });

  const map_container = document.getElementById("map")!;
  const fullscreen_button = document.getElementById("fullscreen")!;
  const locate_button = document.getElementById("locate")!;

  const map_data = JSON.parse(map_container.dataset.map!);
  const map = leaflet.map(map_container, {
    center: leaflet.latLng(map_data.coords_lat, map_data.coords_long),
    zoom: map_data.zoom,
    attributionControl: false,
  });

  fullscreen_button.onclick = () => {
    if (map_container.requestFullscreen) {
      document.fullscreenElement === null ?
          map_container.requestFullscreen() :
          document.exitFullscreen();
    } else {
      map_container.classList.toggle("fullscreen");
    }
    map.invalidateSize()
  }

  locate_button.onclick = () =>
    map.locate({setView: true, maxZoom: 16});

  let located_marker: leaflet.Marker | null = null;
  let located_circle: leaflet.Circle | null = null;
  map.on('locationfound', (e: leaflet.LocationEvent) => {
    located_marker?.remove();
    located_circle?.remove();

    const radius = e.accuracy;
    located_marker = leaflet.marker(e.latlng, { icon: marker_location_icon }).addTo(map);

    if (radius < 10) return;
    located_circle = leaflet.circle(e.latlng, {radius}).addTo(map);
  });

  map.on('locationerror', (e: leaflet.ErrorEvent) => {
    alert(e.message);
  });

  leaflet.tileLayer('https://services.arcgisonline.com/arcgis/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}', {
    maxZoom: 16,
  }).addTo(map);

  map_data.markers?.forEach((marker: any) =>
    leaflet.marker([marker.coords_lat, marker.coords_long], { icon: marker_icon })
      .addTo(map)
      .bindPopup(marker.text)
  );
</script>
